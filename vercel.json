{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/terms", "destination": "/any/terms", "permanent": true },
    { "source": "/refund", "destination": "/any/refund", "permanent": true }
  ],
  "rewrites": [
    { "source": "/any/privacy", "destination": "/any/privacy.html" },
    { "source": "/any/help", "destination": "/any/help.html" }
  ]
}
